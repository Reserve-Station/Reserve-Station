ent-WeaponProtoKineticShotgun = протокинетический дробовик
    .desc = Выпускает множество кинетических зарядов с низким уроном, которые в два раза менее эффективны при добыче полезных ископаемых.
    .suffix = Оружие, Дробовик, Лаваленд
ent-WeaponProtoKineticRepeater = протокинетический репитер
    .desc = Выпускает шквал кинетических разрядов среднего урона с близкого расстояния.
    .suffix = Оружие, Пулемёт, Лаваленд
ent-WeaponProtoKineticPistol = протокинетический пистолет
    .desc = Стреляет кинетическими разрядами с низким уроном, обладает более высокой модулирующей способностью.
    .suffix = Оружие, Пистолет, Лаваленд

ent-ActionTogglePKALight = action-name-toggle-pka-light
    .desc = action-description-toggle-pka-light

ent-WeaponProtoKineticShotgunSpace = { ent-WeaponProtoKineticShotgun }
    .desc = { ent-WeaponProtoKineticShotgun.desc }
    .suffix = Оружие, Дробовик, Лаваленд, Улучшенный
ent-WeaponProtoKineticRepeaterSpace = протокинетический репитер
    .desc = { ent-WeaponProtoKineticRepeater.desc }
    .suffix = Оружие, Пулемёт, Лаваленд, Улучшенный
ent-WeaponProtoKineticPistolSpace = протокинетический пистолет
    .desc = { ent-WeaponProtoKineticPistol.desc }
    .suffix = Оружие, Пистолет, Лаваленд, Улучшенный
