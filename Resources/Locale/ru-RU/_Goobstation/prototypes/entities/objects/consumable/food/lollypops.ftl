# Базовые

ent-FoodSnackLollypopWrappedBase = { ent-FoodBase }
    .desc = Обычный леденец. Всё ещё в обёртке.
ent-FoodSnackLollypopBase = { ent-FoodBase }
    .desc = Обычный леденец. Со вкусом вишни.

ent-FoodSnackLollypopWrappedBaseNanotrasen = завёрнутый леденец NanoTrasen
    .desc = Скорее всего, дорогой леденец. Всё ещё в золотой обёртке.
ent-FoodSnackLollypopBaseNanotrasen = леденец NanoTrasen
    .desc = Дорогой на вкус леденец.

ent-FoodSnackLollypopWrappedBaseCentcomm = завёрнутый леденец ЦентКом
    .desc = Очень дорогой на вкус леденец. Всё ещё в золотой обёртке.
ent-FoodSnackLollypopBaseCentcomm = леденец ЦентКом
    .desc = Очень дорогой на вкус леденец. Может содержать чудовищное количество веществ.

ent-FoodSnackLollypopWrappedBaseSyndicate = завёрнутый леденец
    .desc = Леденец, вероятно, наполненный опасными химикатами. Всё ещё в обёртке.
    .suffix = Синдикат
ent-FoodSnackLollypopBaseSyndicate = леденец
    .desc = Обычный леденец. Этот вызывает у вас плохое предчувствие.
    .suffix = Синдикат

# Обычные

ent-FoodSnackLollypop = леденец
    .desc = Обычный леденец. Со вкусом вишни!
ent-FoodSnackLollypopRainbow = радужный леденец
    .desc = Радужный леденец. Со вкусом слез единорога.
ent-FoodSnackLollypopCarp = леденец-карп
    .desc = Леденец в форме карпа. Осторожно, он кусается!
ent-FoodSnackLollypopCarpEvil = { ent-FoodSnackLollypopCarp }
    .desc = Кто, чёрт возьми, такая Обри Уайт?
    .suffix = Злой
ent-FoodSnackLollypopWeh = леденец Вех!
    .desc = Леденец, наполненный Вех! Вех!

ent-FoodSnackLollypopBlueshield = тёмно-синий леденец
    .desc = Тёмно-синий леденец. Вы чувствуете гордость.
    .suffix = Офицер Синего Щита
ent-FoodSnackLollypopCaptain = леденец капитана
    .desc = Голубоватый леденец на палочке, содержащий потенциально вредное для здоровья количество сусального золота. Только для самых лучших капитанов.
ent-FoodSnackLollypopCentcomm = леденец ЦентКом
    .desc = Зелёный леденец на палочке, содержащий крайне вредное для здоровья количество сусального золота. Только для лучших агентов ЦентКом.
ent-FoodSnackLollypopSyndicate = { ent-FoodSnackLollypopBaseSyndicate }
    .desc = { ent-FoodSnackLollypopBaseSyndicate.desc }
    .suffix = { ent-FoodSnackLollypopBaseSyndicate.suffix }

# Химические

ent-FoodSnackLollypopBicaridine = леденец с бикаридином
    .desc = Леденец, наполненный бикаридином. Со вкусом апельсинов.
ent-FoodSnackLollypopProbital = леденец с пробиталом
    .desc = Ярко-жёлтый леденец с пробиталом. Любимый во всей солнечной галактике!
ent-FoodSnackLollypopKelotane = леденец с келотаном
    .desc = Леденец, наполненный келотаном. Ешьте его в одно и то же время с леденцом с дермалином для достижения максимального эффекта.
ent-FoodSnackLollypopDermaline = леденец с дермалином
    .desc = Леденец, наполненный дермалином. Со вкусом... синего?
ent-FoodSnackLollypopTricordrazine = леденец с трикордразином
    .desc = Леденец, наполненный трикордразином. Любимец докторов!
ent-FoodSnackLollypopDylovene = леденец с диловеном
    .desc = Леденец, наполненный диловеном. Он тускло-фиолетовый.
ent-FoodSnackLollypopOmnizine = леденец с омнизином
    .desc = Леденец, наполненный омнизином. Зарезервирован для лучших пациентов.
ent-FoodSnackLollypopDexalinPlus = леденец с дексалин плюс
    .desc = Леденец, наполненный дексалин плюс. Обычно им пичкают тех, кто забыл про внутренности.
ent-FoodSnackLollypopHyronalin = леденец с хироналином
    .desc = Леденец, наполненный хироналином. Не так эффективно, как вы надеялись.
ent-FoodSnackLollypopIbuprofen = леденец с ибупрофеном
    .desc = Леденец, наполненный ибупрофеном. Оставляет неприятный привкус во рту.
ent-FoodSnackLollypopAntihol = леденец с антихолом
    .desc = Леденец, наполненный антихолом. Лучший друг пьяницы.
ent-FoodSnackLollypopMitotrophin = леденец с митотропином
    .desc = Леденец, наполненный митотропином. На вкус это ужасно, но вы быстро почувствуете себя лучше.
ent-FoodSnackLollypopCognizine = леденец с когнизином
    .desc = Леденец, наполненный когнизином. Он мерцает завораживающим фиолетовым цветом.

