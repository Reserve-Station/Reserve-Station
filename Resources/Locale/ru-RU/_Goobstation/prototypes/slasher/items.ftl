ent-SlasherMachete = мачете
    .desc = Большой, устрашающего вида клинок.
    .suffix = Оружие, Нож, Мясник
ent-ClothingHeadHatSlasherMask = маска мясника
    .desc = Защитная маска для лица, устанавливаемая на голове и предназначенная для полной защиты пользователя от посторонних глаз.
    .suffix = Мясник
ent-ClothingOuterSlasherApron = фартук мясника
    .desc = Необычный фартук для стильной особы.
    .suffix = Мясник
ent-ClothingHandsSlasherGloves = перчатки мясника
    .desc = Тяжёлые чёрные перчатки, покрытые пятнами времени.
    .suffix = Мясник
ent-ClothingShoesSlasher = обувь мясника
    .desc = Старые кожаные ботинки, знававшие лучшие времена.
    .suffix = Мясник
ent-ClothingUniformSlasher = { ent-ClothingUniformJumpsuitColorGrey }
    .desc = Серый комбинезон с лёгким запахом крови.
    .suffix = Мясник
ent-SlasherMeatSpike = жуткий мясной крюк
    .desc = Возможно, вам захочется сбежать.
    .suffix = Мясник

ent-ClothingMaskSlasher = маска мясника
    .desc = Защитная маска для лица. Через неё вы не почувствуете страх, но можете его вызвать.
    .suffix = Мясник

# Spring-locked kit

ent-SlasherMacheteSpring = фиолетовый нож
    .desc = Большой, фиолетовый, устрашающего вида клинок.
    .suffix = Оружие, Мачете, Мясник

ent-ClothingHeadHatSlasherMaskSpring = пружинная маска
    .desc = Глубоко тревожная и механическая на вид маска.
    .suffix = Мясник

ent-ClothingOuterSlasherApronSpring = пружинный костюм
    .desc = Костюм с замысловатыми пружинами по всей внутренней части, как будто он создан для самостоятельного движения. Лучше не подпускать к нему жидкости.
    .suffix = Мясник

# Billy Kit

ent-ClothingHandsSlasherBilly = боевые перчатки
    .desc = Тактические перчатки, постоянно испачканные.
    .suffix = Мясник

ent-ClothingMaskSlasherBilly = противогаз
    .desc = Защитная маска для лица. Через неё вы можете почувствовать страх.
    .suffix = Мясник

ent-ClothingOuterSlasherBilly = пальто Дженсена
    .desc = Сделано из самого прочного синтетического кожзаменителя для самого сурового убийцы.
    .suffix = Мясник

ent-ClothingUniformSlasherBilly = чёрный комбинезон
    .desc = Абсолютно чёрный комбинезон. Стильно, в убийственном смысле.
    .suffix = Мясник

ent-SlasherCrowbar = монтировка
    .desc = Многофункциональный инструмент. Многофункциональность включает убийство.
    .suffix = Мясник

# Cult Kit

ent-ClothingHeadSlasherCult = капюшон культа
    .desc = Нет мясника без культовых капюшонов.
    .suffix = Мясник

ent-ClothingMaskSlasherCult = бездонная маска
    .desc = Маска, созданная из страданий. Когда вы смотрите в её глаза, она смотрит обратно.
    .suffix = Мясник

ent-ClothingOuterSlasherCult = одеяния культа
    .desc = Нет мясника без классических культовых одеяний.
    .suffix = Мясник

ent-SlasherEldritchBlade = потусторонний клинок
    .desc = Меч, гудящий нечестивой энергией. Мясник присвоил его себе.
    .suffix = Оружие, Нож, Мясник

# Maintenance Kit

ent-ClothingHeadSlasherMaintenance = бумажный пакет
    .desc = Улыбающийся бумажный пакет. Как-то более тревожный, чем любая маска.
    .suffix = Мясник

ent-ClothingUniformSlasherMaintenance = монашеская роба
    .desc = Лёгкая роба, носимая странствующим существом.
    .suffix = Мясник

ent-SlasherButchCleaver = мясницкий топор
    .desc = Огромный клинок, используемый для нарезки мяса. Включая экипаж.
    .suffix = Оружие, Топор, Мясник

ent-ClothingOuterSlasherMaintenance = базовая броня
    .desc = Базовая броня. Выглядит немного изношенной.
    .suffix = Мясник

# Cannibal Kit

ent-ClothingUniformSlasherCannibal = поварской костюм
    .desc = Поварской костюм. Всё ещё тёплый после последней смены.
    .suffix = Мясник

ent-ClothingHeadSlasherCannibal = поварской колпак
    .desc = Высокий белый поварской колпак, запятнанный не только жиром.
    .suffix = Мясник

ent-ClothingMaskSlasherCannibal = свиная маска
    .desc = Визжащая свиная маска. Подходит для кого-то с необычным аппетитом.
    .suffix = Мясник

ent-ClothingOuterSlasherCannibal = запятнанный кровью фартук
    .desc = Фартук, пропитанный чем-то, о чём лучше не думать.
    .suffix = Мясник

# Glutton Kit

ent-ClothingOuterSlasherGlutton = органический космический костюм
    .desc = Вы не совсем понимаете, что это такое.
    .suffix = Мясник

ent-ClothingHeadSlasherGlutton = органический космический шлем
    .desc = Вы не совсем понимаете, что это такое.
    .suffix = Мясник

# Clown Kit

ent-ClothingOuterSlasherClown = одеяния матушки-хонк
    .desc = Предназначены для клоуна из духовенства. И для убийств, видимо.
    .suffix = Мясник

ent-ClothingUniformSlasherClown = клоунский костюм
    .desc = ХОНК!
    .suffix = Мясник

ent-ClothingShoesSlasherClown = большие клоунские туфли
    .desc = Когда нужно выделяться в комнате, полной клоунов. Или на месте преступления.
    .suffix = Мясник

ent-ClothingMaskSlasherClown = клоунский парик и маска
    .desc = Настоящее лицевое одеяние шутника. Мясник присвоил его себе.
    .suffix = Мясник

ent-SlasherOffsetCaneClown = радужная трость
    .desc = Радужная трость. Идеально подходит для клоунов и для создания беспорядка.
    .suffix = Мясник

ent-SlasherMeatSpikeClown = зловещая банановая башня
    .desc = Тревожная банановая башня. Возможно, вам стоит убежать.
    .suffix = Мясник

# Clown Kit – Ascended variants

ent-ClothingShoesSlasherClownAscended = клоунские туфли с блестками
    .desc = Сделаны из очищенного бананиума. Вы достигли чего-то поистине беспрецедентного.
    .suffix = Мясник

ent-ClothingUniformSlasherClownAscended = банановый клоунский костюм
    .desc = Клоунский костюм бананового цвета, излучающий энергию хонка.
    .suffix = Мясник

ent-ClothingMaskSlasherClownAscended = банановый клоунский парик и маска
    .desc = Парик и маска матушки-хонк. ХОНК!
    .suffix = Мясник

# Hockey Mask Kit

ent-ClothingMaskSlasherHockey = хоккейная маска
    .desc = Белая хоккейная маска, изношенная и треснувшая. Та, что вы видите прямо перед тем, как гаснет свет.
    .suffix = Мясник

ent-ClothingUniformSlasherHockey = изношенный комбинезон
    .desc = Потертый, грязный комбинезон. Пахнет лесом после дождя. И кровью.
    .suffix = Мясник

ent-ClothingOuterSlasherHockey = плащ хоккейного мясника
    .desc = Тяжелый, изношенный плащ. Что-то тёмное пачкает воротник, а швы выглядят грубо, как будто их делали в темноте.
    .suffix = Мясник
