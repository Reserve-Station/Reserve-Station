cmd-setbatterypercent-desc = Разряжает или заряжает батарею по UID сущности и проценту, напр.: forall with Battery do setbatterypercent $ID 0

cmd-setbatterypercent-help = Использование: setbatterypercent <id> <percent>

cmd-setbatterypercent-battery-not-found = Батарея с ID {$id} не найдена.

cmd-setbatterypercent-not-valid-percent = {$arg} не является допустимым числом с плавающей точкой (процент).
