    .suffix = { ent-CrateCommandSecure.suffix }
ent-CrateRCDAmmo = { ent-CrateEngineering } зарядов РСУ
    .desc = 3 обоймы для РСУ, каждая из которых восстанавливает 5 зарядов.
ent-CrateRCD = { ent-CrateEngineeringSecure } с РСУ
