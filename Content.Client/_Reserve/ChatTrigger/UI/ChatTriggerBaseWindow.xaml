<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      MinSize="440 240"
                      SetSize="440 260">
    <BoxContainer Orientation="Vertical" Margin="8" SeparationOverride="8">
        <RichTextLabel Name="MessageLabel"
                       HorizontalAlignment="Center"
                       Access="Public" />
        <RichTextLabel Name="TriggerLabel"
                       HorizontalAlignment="Center"
                       Visible="False"
                       Access="Public" />
        <PanelContainer StyleClasses="PanelDark">
            <RichTextLabel Name="DescriptionLabel"
                           Margin="8"
                           HorizontalAlignment="Center"
                           Access="Public" />
        </PanelContainer>
        <BoxContainer Orientation="Horizontal"
                      HorizontalAlignment="Center"
                      SeparationOverride="8">
            <Button Name="CancelButton"
                    Text="{Loc 'chat-trigger-cancel-button'}"
                    MinWidth="100"
                    Access="Public" />
            <Button Name="FixButton"
                    Text="{Loc 'chat-trigger-fix-button'}"
                    MinWidth="100"
                    Access="Public" />
            <Button Name="SendAnywayButton"
                    Text="{Loc 'chat-trigger-send-anyway-button'}"
                    MinWidth="100"
                    Access="Public" />
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
